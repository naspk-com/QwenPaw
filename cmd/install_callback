#!/bin/bash

source "${TRIM_APPDEST}/qwenpaw/runtime.sh" || exit 1
qwenpaw_setup || exit 1
exec >> "${TRIM_PKGVAR}/qwenpaw-install.log" 2>&1
qwenpaw_save_log_level "${QWENPAW_LOG_LEVEL}" || exit 1

if [ -f "${TRIM_PKGHOME}/.qwenpaw_keep_runtime" ] && \
    [ -x "${VENV_DIR}/bin/python3" ]; then
    qwenpaw_has_newer_pypi_runtime
    version_status=$?
    case "${version_status}" in
        0) echo "保留已有较新运行环境"; exit 0 ;;
        1) ;;
        *) qwenpaw_report_error "无法确认现有运行环境版本"; exit 1 ;;
    esac
fi

if ! qwenpaw_prepare_runtime bundle "${wizard_pypi_mirror:-tsinghua}"; then
    exit 1
fi
if ! qwenpaw_activate_runtime; then
    exit 1
fi
if [ ! -f "${QWENPAW_WORKING_DIR}/config.json" ]; then
    if ! "${VENV_DIR}/bin/python3" "${TRIM_APPDEST}/qwenpaw/compat.py" \
        init --defaults --accept-security </dev/null; then
        qwenpaw_report_error "初始化失败，保留已有数据"
        exit 1
    fi
fi
echo "QwenPaw 安装完成"
