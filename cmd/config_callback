#!/bin/bash

source "${TRIM_APPDEST}/qwenpaw/runtime.sh" || exit 1
qwenpaw_setup || exit 1
qwenpaw_save_log_level "${QWENPAW_LOG_LEVEL}" || exit 1

PID_FILE="${TRIM_PKGVAR}/qwenpaw.pid"
if [ -f "${PID_FILE}" ]; then
    IFS= read -r pid < "${PID_FILE}" || true
    case "${pid:-}" in
        ''|*[!0-9]*) qwenpaw_report_error "服务进程记录无效"; exit 1 ;;
        *)
            if kill -0 "${pid}" 2>/dev/null; then
                kill -TERM "${pid}" || exit 1
                count=0
                while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 15 ]; do
                    sleep 1
                    count=$((count + 1))
                done
                if kill -0 "${pid}" 2>/dev/null; then
                    qwenpaw_report_error "服务未停止，无法应用新配置"
                    exit 1
                fi
                qwenpaw_exec >> "${TRIM_PKGVAR}/qwenpaw.log" 2>&1 &
                printf '%s\n' "$!" > "${PID_FILE}"
            fi
            ;;
    esac
fi

echo "配置已更新"
exit 0
