#!/bin/bash

source "${TRIM_APPDEST}/qwenpaw/runtime.sh" || exit 1
qwenpaw_setup || exit 1

LOG_FILE="${TRIM_PKGVAR}/qwenpaw-upgrade.log"
exec >> "${LOG_FILE}" 2>&1
echo "开始准备 QwenPaw 升级"

lock_dir="${TRIM_PKGVAR}/qwenpaw-upgrade.lock"
if ! mkdir "${lock_dir}" 2>/dev/null; then
    qwenpaw_report_error "已有升级任务正在运行"
    exit 1
fi
trap 'rmdir "${lock_dir}" 2>/dev/null || true' EXIT

qwenpaw_has_newer_pypi_runtime
version_status=$?
case "${version_status}" in
    0)
        echo "保留控制台安装的较新 QwenPaw 版本"
        exit 0
        ;;
    1) ;;
    *)
        qwenpaw_report_error "无法确认现有运行环境版本，已停止升级"
        exit 1
        ;;
esac

if ! qwenpaw_prepare_runtime bundle "${wizard_pypi_mirror:-tsinghua}"; then
    exit 1
fi
pid_file="${TRIM_PKGVAR}/qwenpaw.pid"
if [ -f "${pid_file}" ]; then
    IFS= read -r pid < "${pid_file}" || true
    case "${pid:-}" in
        ''|*[!0-9]*) qwenpaw_report_error "服务进程记录无效"; exit 1 ;;
        *)
            if kill -0 "${pid}" 2>/dev/null; then
                kill -TERM "${pid}" || exit 1
                count=0
                while kill -0 "${pid}" 2>/dev/null && [ "${count}" -lt 15 ]; do
                    sleep 1
                    count=$((count + 1))
                done
                if kill -0 "${pid}" 2>/dev/null; then
                    qwenpaw_report_error "旧服务未停止，已取消升级"
                    exit 1
                fi
            fi
            rm -f "${pid_file}"
            ;;
    esac
fi
if ! qwenpaw_snapshot_data; then
    qwenpaw_report_error "数据快照失败，已取消切换"
    exit 1
fi
if ! qwenpaw_prepare_channels "${wizard_pypi_mirror:-tsinghua}"; then
    qwenpaw_report_error "旧频道依赖准备失败，已取消切换"
    exit 1
fi
if ! qwenpaw_activate_runtime; then
    exit 1
fi
echo "新运行环境已准备完成，旧环境和用户数据未删除"
